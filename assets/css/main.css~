#main-container {
  display: flex;
  justify-content: center;
  flex-direction: column;
  align-items: center;
  width: 50rem;
  margin: 0 auto;
}

@media (max-width: 50rem) {
  #main-container {
    width: 100%;
  }
}

#main-hr {
  margin-top: 0rem;
  display: none;
}

#content {
  width: 100%;
  margin-top: 1rem;
  outline: 1px solid black;
}

#inner-content {
  margin-left: 0.75rem;
  margin-right: 0.75rem;
}

body {
  font-family: verdana, Monaco, sans-serif
}

/* THEME START: none */
body hr {
  border-top: 1px solid black;
  border-radius: 1px;
}

body a {
  color: #0000ff;
  font-weight: bold;
}

body a:visited {
  color: #800080;
}
/* THEME END: none */

pre code {
  padding: 10px;
  display: block;
}

code {
  background: #272822;
  color: white;
  padding: 0.1rem;
  border-radius: 0.1rem;
  font-size: 13px;
  border: 1px solid white;
  font-family: "JetBrains Mono"
}

/* Styling for the sample under each theme code snippet */
.theme-sample {
  height: 50px;
  width: 100%;
  border: 1px solid white;
  padding: 0.1rem;
}

.theme-sample-link {
  font-weight: bold;
  text-decoration: underline;
}

/* Theme specific rules, these match the values in the select */

/* THEME START: night */
body.night {
  background-color: #202b38;
  color: #dbdbdb;
}

body.night hr {
  border-top: 1px solid #dbdbdb;
}

body.night a {
  color: #70C1FF;
}

body.night a:visited {
  color: #D9A3FF;
}

body.night #content {
  outline: 1px solid white;
}
/* THEME END: night */

/* THEME START: day */
/* https://www.colorhexa.com/f5deb3 */
body.day {
  /* This is wheat */
  background-color: #f5deb3;
  color: #50380B;
}

body.day hr {
  border-top: 1px solid #2D2006;
}

body.day a {
  color: #294765;
}

body.day a:visited {
  color: #6A0DAD;
}

body.day #content {
  outline: 1px solid #50380B;
}
/* THEME END: day */

/* THEME START: carrot_cake */
/* https://www.colorhexa.com/e08d59 */
/* https://encycolorpedia.com/e08d59 */
/* Color is known as Porter Paints Carrot Cake */
body.carrot_cake {
  background-color: #e08d59;
  color: #1C120D;
}

body.carrot_cake hr {
  border-top: 1px solid #290A0B;
}

body.carrot_cake a {
  color: #06084C;
}

body.carrot_cake a:visited {
  color: #29052E;
}

body.carrot_cake #content {
  outline: 1px solid #1C120D;
}
/* THEME END: carrot_cake */

/* THEME START: windows_98 */
body.windows_98 {
  background-color: #c0c0c0;
}

body.windows_98 #main-hr {
  display: block;
  border-top: none;
  background: linear-gradient(90deg, navy, #1084d0);
  height: 15px;
  padding: 3px 2px 3px 3px;
  margin: 3px 3px 0 3px;
}

body.windows_98 #content {
  box-shadow:
    inset -1px -1px #0a0a0a,
    inset 1px 1px #dfdfdf,
    inset -2px -2px grey,
    inset 2px 2px #fff;
}
/* THEME END: windows_98 */

/* THEME START: windows_xp */
body.windows_xp {
  background-color: #ece9d8;
}

body.windows_xp #main-hr {
  display: block;
  background: linear-gradient(
    180deg,
    #0997ff,
    #0053ee 8%,
    #0050ee 40%,
    #06f 88%,
    #06f 93%,
    #005bff 95%,
    #003dd7 96%,
    #003dd7
  );
  padding: 3px 5px 3px 3px;
  border-top: 1px solid #0831d9;
  border-left: 1px solid #0831d9;
  border-right: 1px solid #001ea0;
  border-top-left-radius: 8px;
  border-top-right-radius: 7px;
  height: 21px;
}

body.windows_xp #content {
  box-shadow:
    inset -1px -1px #00138c,
    inset 1px 1px #0831d9,
    inset -2px -2px #001ea0,
    inset 2px 2px #166aee,
    inset -3px -3px #003bda,
    inset 3px 3px #0855dd;
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
}
/* THEME END: windows_xp */

