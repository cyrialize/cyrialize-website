document.addEventListener('DOMContentLoaded', function() {
    let theme = getTheme();
    setTheme(theme);
    setThemeSelect(theme);
});

const internalCssThemes = [
    'none',
    'night',
    'day',
    'carrot_cake'
];

const externalCssThemes = {
    'windows_98': 'https://unpkg.com/98.css'
};


function selectTheme(event) {
    let chosenTheme = document.getElementById('themes').value;
    setTheme(chosenTheme);
    saveTheme(chosenTheme);
}

// TODO: It might just be better to incorporate 98 CSS into the actual file
// instead of loading externally because there a slight blip
function setTheme(theme) {
    let body = document.getElementsByTagName('body')[0];
    let externalCss = document.getElementById('external-css');

    if (theme === 'none') {
	body.classList = [];
	externalCss.href = "";

    } else if (internalCssThemes.includes(theme)) {
	body.classList = [theme];
	externalCss.href = "";

    } else if (Object.keys(externalCssThemes).includes(theme)) {
	externalCss.href = externalCssThemes[theme];
	body.classList = [];
    }
}

function saveTheme(theme) {
    localStorage.setItem('cyrialize-theme', theme);
}

function setThemeSelect(theme) {
    document.getElementById('themes').value = theme;
}

function getTheme() {
    let savedTheme = localStorage.getItem('cyrialize-theme');
    if (savedTheme === null) {
	localStorage.setItem('cyrialize-theme', 'none');
	return 'none';
    }
    return savedTheme;
}
